+def _compile_segment(segment):
+    return [_STAR if c == "*" else c for c in segment]
+
+
+def _segment_matches(tokens, name):
+    """Match `name` against a list of characters and STARs (`?` matches any one character).
+
+    Greedy matching that only backtracks to the last STAR: O(len(tokens) * len(name)).
+    """
+    p = i = 0
+    star_p = star_i = -1
+    while i < len(name):
+        if p < len(tokens) and tokens[p] is _STAR:
+            star_p, star_i = p, i
+            p += 1
+        elif p < len(tokens) and (tokens[p] == "?" or tokens[p] == name[i]):
+            p += 1
+            i += 1
+        elif star_p >= 0:
+            star_i += 1
+            p, i = star_p + 1, star_i
+        else:
+            return False
+    while p < len(tokens) and tokens[p] is _STAR:
+        p += 1
+    return p == len(tokens)
+
+
+def _path_matches(segments, parts):
+    """Match path components against compiled segments and GLOBSTARs."""
+    reachable = {0}
+    for seg in segments:
+        if seg is _GLOBSTAR:
+            reachable = {i + k for i in reachable for k in range(_GLOBSTAR_MAX + 1)
+                         if i + k <= len(parts)}
+        else:
+            reachable = {i + 1 for i in reachable
+                         if i < len(parts) and _segment_matches(seg, parts[i])}
+        if not reachable:
+            return False
+    return len(parts) in reachable
+
+
+def _compile_glob(glob, anchored):
+    """Anchored globs become a list of compiled path components and GLOBSTARs (`**`)."""
+    if not anchored:
+        return _compile_segment(glob)
+    return [_GLOBSTAR if seg == "**" else _compile_segment(seg) for seg in glob.split("/")]
+
+
+def _rule_matches(globs, anchored, rel):
+    if anchored:
+        return any(_path_matches(g, rel) for g in globs)
+    return any(_segment_matches(g, rel[-1]) for g in globs)
+
+
+def _parse(text):
+    """Return a list of (negate, dir_only, anchored, score, globs) rules."""
+    rules = []
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith(";"):
+            continue
+        negate = line.startswith("!")
+        if negate:
+            line = line[1:]
+        dir_only = line.endswith("/")
+        line = line.rstrip("/")
+        anchored = "/" in line
+        line = line.lstrip("/")
+        if not line:
+            continue
+        score = sum(c not in "*?/{}," for c in line)
+        globs = [_compile_glob(g, anchored) for g in dict.fromkeys(_expand_braces(line))]
+        rules.append((negate, dir_only, anchored, score, globs))
+    return rules
 
 
