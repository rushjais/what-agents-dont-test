+
+class PackignoreError(Exception):
+    """packignore refuses the tree (too large, or a path is both a file and a directory)."""
+
+
+# packignore's input limits.
+_MAX_FILES = 5000
+_MAX_DEPTH = 64  # path components
+_MAX_NAME_UNITS = 255  # UTF-16 code units per path component
+_MAX_PATH_BYTES = 955  # UTF-8 bytes per relative path
+_MAX_LINES = 2000  # per .packignore
+_MAX_LINE_CHARS = 1000
+
+
+def _fold(name):
+    return unicodedata.normalize("NFD", unicodedata.normalize("NFD", name).casefold())
+
+
+def _walk(root):
+    """Return {path: contents-or-None} for the files under `root`, in walk order."""
+    files = {}
+    for dirpath, dirnames, filenames in os.walk(root):
+        if os.path.samefile(dirpath, root) and ".git" in dirnames:
+            dirnames.remove(".git")
+        for name in filenames:
+            full = os.path.join(dirpath, name)
+            rel = os.path.relpath(full, root).replace(os.sep, "/")
+            if name == ".packignore":
+                with open(full, newline="") as f:
+                    files[rel] = f.read()
+            else:
+                files[rel] = None
+    return files
+
+
+def _check_limits(files):
+    """Reject the inputs packignore refuses to evaluate."""
+    if len(files) > _MAX_FILES:
+        raise PackignoreError(f"too many files (limit {_MAX_FILES})")
+    for rel, content in files.items():
+        parts = rel.split("/")
+        if len(parts) > _MAX_DEPTH:
+            raise PackignoreError(f"path too deep (limit {_MAX_DEPTH} levels)")
+        try:
+            too_long = len(rel.encode("utf-8")) > _MAX_PATH_BYTES or \
+                any(len(part.encode("utf-16-le")) > 2 * _MAX_NAME_UNITS for part in parts)
+        except UnicodeEncodeError:  # undecodable file name
+            too_long = True
+        if too_long or "\0" in rel:
+            raise PackignoreError(f"cannot handle path {rel!r}")
+        if content is not None:
+            lines = content.splitlines()
+            if len(lines) > _MAX_LINES or any(len(line) > _MAX_LINE_CHARS for line in lines):
+                raise PackignoreError(f"ignore file too large (limits: {_MAX_LINES} lines, "
+                                      f"{_MAX_LINE_CHARS} characters per line)")
+
+
+def _merge(files):
+    """Merge entries the way a case/normalization-insensitive file system would."""
+    dirs = {(): ()}  # folded parts -> spelled parts
+    merged = {}  # folded parts -> [spelled path, contents]
+    for rel, content in files.items():
+        parts = rel.split("/")
+        spelled = ()
+        key = ()
+        for part in parts[:-1]:
+            key += (_fold(part),)
+            if key in merged:
+                raise PackignoreError(f"invalid tree: {'/'.join(merged[key][0])!r} is both a file "
+                                      f"and a directory")
+            if key not in dirs:
+                dirs[key] = spelled + (part,)
+            spelled = dirs[key]
+        key += (_fold(parts[-1]),)
+        if key in dirs:
+            raise PackignoreError(f"invalid tree: {'/'.join(dirs[key])!r} is both a file and a "
+                                  f"directory")
+        if key in merged:
+            merged[key][1] = content
+        else:
+            merged[key] = [spelled + (parts[-1],), content]
+    return {"/".join(spelled): content for spelled, content in merged.values()}
+
+
+def _expand_braces(pattern):
+    start = pattern.find("{")
+    if start < 0:
+        return [pattern]
+    end = pattern.find("}", start)
+    if end < 0:
+        return [pattern]
+    head = pattern[:start]
+    rests = _expand_braces(pattern[end + 1:])
+    return [head + alt + rest for alt in pattern[start + 1:end].split(",") for rest in rests]
+
+
+_STAR = object()
+_GLOBSTAR = object()
+_GLOBSTAR_MAX = 3  # packignore's `**` spans at most this many path components
+
 
