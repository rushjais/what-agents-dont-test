+# --- Patterns ---------------------------------------------------------------
+
+class _Pattern:
+    __slots__ = ("negate", "dir_only", "anchored", "segments", "score")
+
+    def __init__(self, negate, dir_only, anchored, segments, score):
+        self.negate = negate
+        self.dir_only = dir_only
+        self.anchored = anchored
+        self.segments = segments  # glob strings, or None for a "**" segment
+        self.score = score
+
+
+def _glob(pat, name):
+    """fnmatch-style match where only "*" and "?" are special.
+
+    Greedy with single-star backtracking, so it can't blow up on patterns
+    like "*?*?*?..." the way a backtracking regex does.
+    """
+    p = i = 0
+    star = -1
+    mark = 0
+    while i < len(name):
+        if p < len(pat) and pat[p] == "*":
+            star, mark = p, i
+            p += 1
+        elif p < len(pat) and (pat[p] == "?" or pat[p] == name[i]):
+            p += 1
+            i += 1
+        elif star >= 0:
+            mark += 1
+            p, i = star + 1, mark
+        else:
+            return False
+    while p < len(pat) and pat[p] == "*":
+        p += 1
+    return p == len(pat)
+
+
+def _parse_line(line):
+    line = line.strip()
+    if not line or line.startswith(";"):
+        return None
+    negate = line.startswith("!")
+    if negate:
+        line = line[1:]
+    score = sum(1 for ch in line if ch not in "*?/")
+    dir_only = line.endswith("/")
+    line = line.rstrip("/")
+    anchored = "/" in line
+    line = line.lstrip("/")
+    if not line:
+        return None
+    segments = [None if seg == "**" else seg for seg in line.split("/")]
+    return _Pattern(negate, dir_only, anchored, segments, score)
+
+
+def _read_patterns(source):
+    with open(source, "rb") as f:
+        data = f.read()
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError:
+        raise PackignoreError(f"{PACKIGNORE} is not valid UTF-8: {source}") from None
+    patterns = [p for p in map(_parse_line, text.splitlines()) if p is not None]
+    # Highest score first, later lines first among equals: the first match wins.
+    return [p for _, p in sorted(enumerate(patterns), key=lambda e: (-e[1].score, -e[0]))]
+
+
+def _match_segments(segs, parts):
+    """Match pattern segments against path segments; "**" spans 0 to 3 of them."""
+    memo = {}
+
+    def go(i, j):
+        key = (i, j)
+        if key in memo:
+            return memo[key]
+        if i == len(segs):
+            res = j == len(parts)
+        elif segs[i] is None:
+            res = any(go(i + 1, k) for k in range(j, min(j + _GLOBSTAR_SPAN, len(parts)) + 1))
+        else:
+            res = j < len(parts) and _glob(segs[i], parts[j]) and go(i + 1, j + 1)
+        memo[key] = res
+        return res
