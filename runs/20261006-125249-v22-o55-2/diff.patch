+def _compile(line, depth, index):
+    """Turn one stripped, non-comment line into a _Rule, or None."""
+    negated = line.startswith("!")
+    if negated:
+        line = line[1:]
+    literal = sum(1 for ch in line if ch not in "*?/")
+    dir_only = line.endswith("/")
+    body = line.rstrip("/")
+    anchored = body.startswith("/") or "/" in body.strip("/")
+    body = body.lstrip("/")
+    if not body:
+        return None
+    parts = []
+    if not anchored:
