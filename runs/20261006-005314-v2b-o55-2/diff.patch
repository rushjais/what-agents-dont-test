+import re
+
+_NAME = ".packignore"
+_GLOBSTAR_MAX = 3
+_BRACES = re.compile(r"\{([^}]*)\}")
+_UNSCORED = set("*?{},/")
+
+
+def _expand(pat):
+    m = _BRACES.search(pat)
+    if not m:
+        return [pat]
+    prefix = pat[:m.start()]
+    rests = _expand(pat[m.end():])
+    return [prefix + alt + rest for alt in m.group(1).split(",") for rest in rests]
+
+
+def _segment_re(seg):
+    out = []
+    for ch in seg:
+        if ch == "*":
+            if not out or out[-1] != "[^/]*":
+                out.append("[^/]*")
+        elif ch == "?":
+            out.append("[^/]")
+        else:
+            out.append(re.escape(ch))
+    return re.compile("".join(out), re.DOTALL)
+
+
+class _Rule:
+    __slots__ = ("negate", "dir_only", "anchored", "score", "alts")
+
+    def __init__(self, negate, dir_only, anchored, pat):
+        self.negate = negate
+        self.dir_only = dir_only
+        self.anchored = anchored
+        self.score = sum(1 for ch in pat if ch not in _UNSCORED)
+        self.alts = []
+        for alt in _expand(pat):
+            if anchored:
+                self.alts.append([None if s == "**" else _segment_re(s) for s in alt.split("/")])
+            else:
+                self.alts.append(_segment_re(alt))
+
+    def matches(self, parts, is_dir):
+        """`parts` is the path relative to the rule's directory, split on "/"."""
+        if self.dir_only and not is_dir:
+            return False
+        if self.anchored:
+            return any(_match_segments(alt, 0, parts, 0) for alt in self.alts)
+        name = parts[-1]
+        return any(r.fullmatch(name) for r in self.alts)
+
+
+def _match_segments(pat, i, parts, j):
+    if i == len(pat):
+        return j == len(parts)
+    if pat[i] is None:
+        for k in range(min(_GLOBSTAR_MAX, len(parts) - j) + 1):
+            if _match_segments(pat, i + 1, parts, j + k):
+                return True
+        return False
+    if j == len(parts) or not pat[i].fullmatch(parts[j]):
+        return False
+    return _match_segments(pat, i + 1, parts, j + 1)
+
+
+def _parse(text):
+    rules = []
+    for line in text.splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        negate = line.startswith("!")
+        if negate:
+            line = line[1:]
+        dir_only = line.endswith("/")
+        line = line.rstrip("/")
+        anchored = line.startswith("/")
+        line = line.lstrip("/")
+        if not line:
+            continue
+        anchored = anchored or "/" in line
+        rules.append(_Rule(negate, dir_only, anchored, line))
+    return rules
+
+
+def _walk(root):
+    """Mirror the tree listing packignore was given: files and .packignore texts."""
+    files = []
+    texts = {}
+    for dirpath, dirnames, filenames in os.walk(root):
+        if os.path.samefile(dirpath, root) and ".git" in dirnames:
+            dirnames.remove(".git")
+        for name in filenames:
+            full = os.path.join(dirpath, name)
+            rel = os.path.relpath(full, root).replace(os.sep, "/")
+            files.append(rel)
+            if name == _NAME:
+                with open(full, newline="") as f:
+                    texts[rel] = f.read()
+    return files, texts
+
+
+class _Engine:
+    def __init__(self, texts):
+        # Directory ("" for root) -> rules of the .packignore in it.
+        self.rules = {}
+        for rel, text in texts.items():
+            self.rules[rel[:-len(_NAME)].rstrip("/")] = _parse(text)
+        self.dir_excluded = {}
+
+    def _read(self, d):
+        return d == "" or not self.excluded(d, True)
 
