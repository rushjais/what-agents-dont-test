+    def excluded(self, path, is_dir):
+        if is_dir and path in self.dir_excluded:
+            return self.dir_excluded[path]
+        parts = path.split("/")
+        # Directories holding a .packignore that applies to `path`.
+        sources = []
+        for depth in range(len(parts)):
+            d = "/".join(parts[:depth])
+            if d in self.rules and self._read(d):
+                sources.append((depth, self.rules[d]))
+        result = False
+        for level in range(len(parts), 0, -1):
+            best = None
+            level_is_dir = is_dir or level < len(parts)
+            for depth, rules in sources:
+                if depth >= level:
+                    continue
+                rel = parts[depth:level]
+                for idx, rule in enumerate(rules):
+                    if rule.matches(rel, level_is_dir):
+                        key = (depth, rule.score, idx)
+                        if best is None or key > best[0]:
+                            best = (key, rule)
+            if best is not None:
+                result = not best[1].negate
+                break
+        if is_dir:
+            self.dir_excluded[path] = result
+        return result
 
 
