+def _read_rules(path, depth):
+    with open(path, "rb") as f:
+        text = f.read().decode("utf-8")
+    rules = []
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith(";"):
+            continue
+        rules.append(_Rule(line, depth, len(rules)))
+    return rules
+
