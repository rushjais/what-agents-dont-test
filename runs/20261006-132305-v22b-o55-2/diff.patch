+def _match_segments(pattern, path):
+    """Match compiled segments (None for `**`) against all of `path`."""
+    @functools.lru_cache(maxsize=None)
+    def match(i, j):
+        if i == len(pattern):
+            return j == len(path)
+        if pattern[i] is None:
+            return any(match(i + 1, k) for k in range(j, min(j + _MAX_STARSTAR, len(path)) + 1))
+        return j < len(path) and pattern[i].fullmatch(path[j]) is not None and match(i + 1, j + 1)
+
+    return match(0, 0)
+
