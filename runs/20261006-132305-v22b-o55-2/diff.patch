+def _expand_braces(pattern):
+    """Expand `{a,b}` groups. A group runs from a `{` to the next `}`; groups
+    don't nest, and an unclosed `{` is literal."""
+    start = pattern.find("{")
+    end = pattern.find("}", start + 1) if start >= 0 else -1
+    if end < 0:
+        return [pattern]
+    rest = _expand_braces(pattern[end + 1:])
+    return [pattern[:start] + alt + tail for alt in pattern[start + 1:end].split(",") for tail in rest]
+
