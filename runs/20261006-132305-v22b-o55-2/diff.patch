+def _decide(sources, path, is_dir):
+    """Return True/False if a pattern decides `path`, None if none matches.
+
+    `sources` is a list of (directory segments, rules) for every .packignore
+    that applies to `path`.
+    """
+    best = None
+    for base, rules in sources:
+        rel = path[len(base):]
+        for rule in rules:
+            if (best is None or rule.rank > best.rank) and rule.matches(rel, is_dir):
+                best = rule
+    return None if best is None else not best.negated
 
 
